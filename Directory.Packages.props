    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.2" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="Blake3" Version="3.0.2" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="Spectre.Console" Version="0.57.2" />
    <PackageVersion Include="System.Formats.Cbor" Version="11.0.0" />
    <PackageVersion Include="System.IO.Hashing" Version="11.0.0" />
